# Copy to `.env` and adjust. Every value is optional — the defaults below are
# what the compose files use when a variable is unset.
#
#   cp .env.example .env

# --- App container ---------------------------------------------------------

# Image tag to run (any published tag, e.g. latest, v0.1.0-alpha).
IMAGE_TAG=latest

# Host port the app is exposed on.
PORT=8080

# Host directory for persistent data: config.toml, avatars, SQLite database.
DATA_DIR=./data

# Container timezone (e.g. UTC, Asia/Kolkata).
TZ=Asia/Kolkata

# Stable JWT secret (64 chars). Leave empty to auto-generate on first run.
# Set it so existing sessions survive container restarts.
FINANCER_JWT_SECRET=

# --- SurrealDB (docker-compose.yml only) -----------------------------------

# Credentials for the bundled SurrealDB (the app connects with the same ones).
SURREAL_USER=root
SURREAL_PASS=root

# SurrealDB log level.
SURREAL_LOG=info

# SurrealDB namespace + database the app uses.
SURREAL_NS=financer
SURREAL_DB=financer
