# Copy to `.env` and adjust. Every value is optional — the defaults below are
# what the compose files use when a variable is unset.
#
#   cp .env.example .env

# --- App container ---------------------------------------------------------

# Image tag to run (any published tag, e.g. latest, v0.1.0-alpha).
IMAGE_TAG=latest

# Host port the app is exposed on.
PORT=8080

# Host directory for persistent data: SQLite database, avatars.
DATA_DIR=./data

# Timezone: sets both the container clock and the app's date/day bucketing.
TZ=Asia/Kolkata

# Required: JWT signing secret. The server refuses to start without it.
# Generate with: openssl rand -hex 32
FINANCER_JWT_SECRET=

# --- SurrealDB (docker-compose.yml only) -----------------------------------

# Credentials for the bundled SurrealDB (the app connects with the same ones).
SURREAL_USER=root
SURREAL_PASS=root

# SurrealDB log level.
SURREAL_LOG=info

# SurrealDB namespace + database the app uses.
SURREAL_NS=financer
SURREAL_DB=financer
