# Copy to `.env` and adjust. Every value is optional — the defaults below are
# what docker-compose.yml uses when a variable is unset.
#
#   cp .env.example .env

# --- App container ---------------------------------------------------------

# Image tag to run (any published tag, e.g. latest, v0.1.0-alpha).
IMAGE_TAG=latest

# Host port the app is exposed on.
PORT=8080

# Host directory for persistent data: SQLite database, avatars.
DATA_DIR=./data

# Timezone: sets both the container clock and the app's date/day bucketing.
TZ=Asia/Kolkata

# Required: JWT signing secret. The server refuses to start without it.
# Generate with: openssl rand -hex 32
FINANCER_JWT_SECRET=

# Logging: debug | info (default) | warn | error.
# FINANCER_LOG_LEVEL=info

# Optional: append logs to a file instead of stderr. In the container the data
# volume is mounted at /data, so /data/financer.log persists across restarts.
# The active file rotates at 10 MB and only 3 files are kept (the oldest is
# deleted automatically). Leave unset to use `docker logs`.
# FINANCER_LOG_FILE=/data/financer.log
